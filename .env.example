# Neon Postgres — pooled connection, used by the app at runtime via the Neon driver adapter.
# Neon console → your project → Connect → "Pooled connection". Host includes "-pooler".
DATABASE_URL=

# Neon Postgres — direct/unpooled connection, used only by the Prisma CLI (migrate, db push,
# introspect) via prisma7.config.ts. Same Connect dialog → uncheck "Pooled connection".
# Host has no "-pooler".
DATABASE_URL_UNPOOLED=

# Neon Managed Better Auth (not self-hosted Better Auth — Neon runs the auth server for us).
# Neon console → your project → Auth tab → Project Info. Copy the "Auth URL" value as-is.
NEON_AUTH_BASE_URL=

# Any random string, 32+ characters. Not shown in the Neon console — generate your own:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Client-safe app URL, no trailing slash, e.g. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=

# Seed-only: credentials for the platform super admin created by prisma/seed.ts.
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_PLATFORM_ADMIN_NAME=
